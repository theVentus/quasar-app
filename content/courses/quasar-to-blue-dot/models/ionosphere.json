{
  "spec": "explore/1",
  "id": "ionosphere",
  "title": "Ionospheric delay and the two-frequency trick",
  "vars": [
    {
      "id": "TEC",
      "label": "Total electron content along the path",
      "min": 1,
      "max": 150,
      "value": 30,
      "step": 1,
      "unit": "TECU"
    },
    {
      "id": "f",
      "label": "Signal frequency",
      "min": 1000000000,
      "max": 3000000000,
      "value": 1575420000,
      "unit": "Hz",
      "digits": 4,
      "presets": [
        [
          "L1",
          1575420000
        ],
        [
          "L2",
          1227600000
        ],
        [
          "L5",
          1176450000
        ]
      ]
    }
  ],
  "defs": [
    [
      "K",
      "40.3*TEC*1e16"
    ],
    [
      "I1",
      "K/f_L1^2"
    ],
    [
      "I2",
      "K/f_L2^2"
    ]
  ],
  "outputs": [
    {
      "label": "Code delay at this frequency",
      "expr": "K/f^2",
      "unit": "m"
    },
    {
      "label": "Carrier phase shift",
      "expr": "-K/f^2",
      "unit": "m"
    },
    {
      "label": "Measured L2 minus L1 difference",
      "expr": "I2 - I1",
      "unit": "m"
    },
    {
      "label": "L1 delay recovered from it",
      "expr": "(I2 - I1)*f_L2^2/(f_L1^2 - f_L2^2)",
      "unit": "m"
    }
  ],
  "plot": {
    "x": "f",
    "y": [
      "K/f^2"
    ],
    "xlabel": "Frequency",
    "ylabel": "Code delay",
    "yunit": "m"
  },
  "caption": "To first order the delay is $40.3\\,\\mathrm{TEC}/f^{2}$ metres, with TEC in electrons per square metre ($1$ TECU $=10^{16}$). The code is delayed and the carrier phase advanced by the same amount. Because the delay scales as $1/f^{2}$, the difference between two frequencies reveals it: the last output equals the L1 delay exactly, whatever the electron content."
}
